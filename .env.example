# ============================================================
# next-dashboard-kit 环境变量示例
# 复制为 .env.local 并按需填写；纯静态看板模式下全部留空即可运行
# ============================================================

# ---- LLM（AI 投顾对话 / 事件分析等 AI 能力，可选） ----
# 任意 OpenAI 兼容接口：OpenAI / DeepSeek / 豆包 Ark / 通义 / 本地 Ollama 等
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat

# ---- 万得 Wind 行情（可选：AI 对话注入当日客观盘面） ----
# WIND_API_KEY=

# ---- 事件调度器（可选：每日 05:00 自动抓取事件，需 Python + akshare） ----
# ENABLE_EVENTS_SCHEDULER=1

# ---- PostgreSQL（可选：投资事件库持久化，纯静态模式不需要） ----
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=market_data
# DB_USER=postgres
# DB_PASSWORD=postgres
